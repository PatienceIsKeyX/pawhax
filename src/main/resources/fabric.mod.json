{
  "schemaVersion": 1,
  "id": "diagbounce",
  "version": "${version}",
  "name": "DiagBounce",
  "description": "High-speed diagonal elytra bounce for Meteor Client.",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.diagbounce.DiagBounceAddon"
    ]
  },
  "mixins": [
    "diagbounce.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
